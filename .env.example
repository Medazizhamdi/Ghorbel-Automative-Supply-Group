# PostgreSQL connection string (Render provides this for a managed database).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autopieces360?schema=public"
API_PORT=10001
WEB_ORIGIN=http://localhost:5174
VITE_API_URL=http://localhost:10001
# Use random values of at least 32 characters in Render.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GUEST_TOKEN_ENCRYPTION_KEY=replace-with-a-different-persistent-random-secret-of-at-least-32-characters
ADMIN_BOOTSTRAP_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
# SMTP for order confirmations and transactional notifications.
# Port 587 usually uses STARTTLS (SMTP_SECURE=false); port 465 uses implicit TLS (true).
# Use the SMTP/app password issued by your provider, not necessarily your mailbox password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AutoPièces 360 <no-reply@your-domain.tn>
